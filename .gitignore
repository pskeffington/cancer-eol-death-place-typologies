# Data policy
# Keep small documentation files in Git. Do not commit raw public-use extracts if large.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/crosswalks/*
!data/crosswalks/.gitkeep

# Outputs
outputs/*
!outputs/.gitkeep
figures/*
!figures/.gitkeep
tables/*
!tables/.gitkeep

